# O'yin — maxfiy sozlamalar namunasi.
# Shu faylni ".env" nomi bilan nusxalang va qiymatlarni yozing.
# (.env GitHub'ga yuklanmaydi — parol va kalitlar faqat sizning kompyuteringizda qoladi.)

# Google Gemini API kaliti (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Owner (sayt egasi) — kirish sahifasida «Owner» bilan kiriladi
OWNER_LOGIN=
OWNER_PASSWORD=
OWNER_NAME=

# ElevenLabs API kaliti (ixtiyoriy) — uy vazifa natijasini ovozda o'qib berish. Panel -> Sozlamalardan ham qo'yish mumkin
ELEVENLABS_API_KEY=
